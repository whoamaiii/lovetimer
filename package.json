{
  "name": "timer-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "bash bin/launch.sh",
    "dev": "vite --port 5173 --host",
    "build": "vite build",
    "preview": "vite preview --port 3000 --host",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write index.html \"src/**/*.{js,css,html,json}\"",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:assets": "node bin/render-app-art.mjs && capacitor-assets generate --ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "canvas-confetti": "^1.9.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^5.4.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "prettier": "^3.5.3",
    "sharp": "^0.35.3",
    "vite": "^6.3.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\\\.(css|less|scss|sass)$": "identity-obj-proxy"
    }
  }
}
